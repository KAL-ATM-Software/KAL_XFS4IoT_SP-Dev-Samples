<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>XFS4IoT.TestTool</AssemblyName>
    <RootNamespace>XFS4IoT.TestTool</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <OutputPath>..\bin\Debug\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <OutputPath>..\bin\Release\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KAL.XFS4IoT.SP-Dev.Framework.Server" Version="3.3.8" />
    <!-- Referenced explicitly (it's already a transitive dependency of the Server package at the
         same version) purely so GeneratePathProperty exposes $(PkgKAL_XFS4IoT_SP-Dev_Framework_Core)
         below — that's what lets us copy its XML doc comments into the PropertyGrid descriptions. -->
    <PackageReference Include="KAL.XFS4IoT.SP-Dev.Framework.Core" Version="3.3.8" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Core package ships XML doc comments next to its DLL, but NuGet doesn't copy that file
         to the output directory on its own. Embedding it directly into this assembly (rather than
         copying it to the output directory as a loose file) means it can never go missing when
         the built exe is copied to a different test machine — ReflectedPropertyDescriptor reads it
         via XmlDocComments to show real field descriptions (e.g. "Track 1 of the magnetic stripe
         will be read.") instead of just the field name. LogicalName is set explicitly because the
         file lives outside the project directory, where the default logical-name generation is
         unpredictable. -->
    <EmbeddedResource Include="$(PkgKAL_XFS4IoT_SP-Dev_Framework_Core)\lib\net8.0\XFS4IoT.SP.Framework.Core.xml" Condition="Exists('$(PkgKAL_XFS4IoT_SP-Dev_Framework_Core)\lib\net8.0\XFS4IoT.SP.Framework.Core.xml')" LogicalName="XFS4IoT.SP.Framework.Core.xml" Visible="false" />
  </ItemGroup>

</Project>
